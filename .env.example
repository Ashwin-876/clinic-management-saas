# PostgreSQL Connection String (e.g. Neon, Supabase, AWS RDS, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for Session Cookies
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-chars"

# Node Environment
NODE_ENV="production"

# Public App URL (set to your Vercel deployment URL or custom domain)
NEXT_PUBLIC_APP_URL="https://your-clinic-domain.vercel.app"
